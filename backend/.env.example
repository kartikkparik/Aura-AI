# ===========================================
# Aura AI v2.5 — Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Get a FREE Groq API key at: https://console.groq.com
# ===========================================

# Required: Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# AI Model Configuration (optional comma-separated list of Groq models)
# Default: openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# AI Request Timeout in seconds (default: 25.0)
GROQ_TIMEOUT=25.0

# Flask Configuration
SECRET_KEY=generate_a_random_32_char_string_here
PORT=5000

# Production CORS: Allowed frontend origin(s)
# In production, set to your custom domain or Vercel URL (e.g., https://your-domain.com)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Gunicorn Concurrency (optional)
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
